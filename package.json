{
  "name": "qa-automation-framework-cypress",
  "version": "1.0.0",
  "description": "End-to-end and API test automation framework built with Cypress, following best practices for scalable test architecture.",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:e2e": "cypress run --spec \"cypress/e2e/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriellamaas/qa-automation-framework-cypress.git"
  },
  "keywords": [],
  "author": "Gabriella Maas",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gabriellamaas/qa-automation-framework-cypress/issues"
  },
  "homepage": "https://github.com/gabriellamaas/qa-automation-framework-cypress#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.11.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
